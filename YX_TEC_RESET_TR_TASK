  CALL METHOD cl_gui_control=>set_focus EXPORTING control = lo_alv.
*&---------------------------------------------------------------------*
*& Form select_data
*&---------------------------------------------------------------------*
FORM select_data USING p_user TYPE xubname
                       p_datu TYPE dats
                       p_mode TYPE xuvalue
                       p_unas TYPE xfeld
              CHANGING ct_selection TYPE e070t_t.


* Get Tasks for user.
  SELECT
  FROM e070 AS e
  INNER JOIN e07t AS t
  ON e~trkorr = t~trkorr
  FIELDS e~*, t~as4text
  WHERE e~as4user = @p_user
    AND e~as4date >= @p_datu
    AND t~langu = @sy-langu
  AND (
  e~trfunction = @lc_trfunction_q OR
  e~trfunction = @lc_trfunction_r OR
  e~trfunction = @lc_trfunction_s OR
  e~trfunction = @lc_trfunction_x
  )
  ORDER BY e~trkorr DESCENDING
  INTO CORRESPONDING FIELDS OF TABLE @ct_selection.

*   Get Parent Transport Requests.
  SELECT
  FROM e070
  FIELDS *
  FOR ALL ENTRIES IN @ct_selection
  WHERE trkorr = @ct_selection-strkorr
  INTO TABLE @DATA(lt_e070_tr).

  SORT lt_e070_tr BY trkorr as4date DESCENDING.

*     Get Project Assignments.
  SELECT
  FROM e070a
  FIELDS *
  FOR ALL ENTRIES IN @lt_e070_tr
  WHERE trkorr = @lt_e070_tr-trkorr
    AND attribute = 'SAP_CTS_PROJECT'
  INTO TABLE @DATA(lt_e070a_tr).

*       Get rid of unnecessary entries, where Transport Request status is R = Released
  LOOP AT lt_e070_tr REFERENCE INTO DATA(lr_transport) WHERE trstatus = lc_trfunction_r.
    DELETE ct_selection WHERE strkorr = lr_transport->trkorr.
  ENDLOOP.
  DELETE lt_e070_tr WHERE trstatus = lc_trfunction_r.

  IF p_unas = abap_true.
    LOOP AT lt_e070_tr REFERENCE INTO lr_transport.
      IF NOT line_exists( lt_e070a_tr[ trkorr = lr_transport->trkorr ] ).
        DELETE ct_selection WHERE strkorr = lr_transport->trkorr.
        DELETE lt_e070_tr   WHERE trkorr  = lr_transport->trkorr.
      ENDIF.
    ENDLOOP.
  ENDIF.

  SORT ct_selection BY strkorr trfunction as4date DESCENDING.
  IF p_mode <> 'EXPERT'.
    DELETE ADJACENT DUPLICATES FROM ct_selection COMPARING strkorr trfunction.
  ENDIF.
*  SORT lt_e070_user BY strkorr as4date DESCENDING.

*       Add color, set parent type.
  LOOP AT ct_selection REFERENCE INTO DATA(lr_e070_user).
    IF NOT lr_e070_user->trstatus = lc_trstatus_d.
      lr_e070_user->line_color = lc_linecolor_green. "green
    ENDIF.
    lr_e070_user->funct_txt   = lt_trfunc_fixvals[ low = lr_e070_user->trfunction ]-ddtext.
    lr_e070_user->parent_type = lt_e070_tr[ trkorr = lr_e070_user->strkorr ]-trfunction.
    lr_e070_user->parent_txt  = lt_trfunc_fixvals[ low = lr_e070_user->parent_type ]-ddtext.
    lr_e070_user->parent_own = lt_e070_tr[ trkorr = lr_e070_user->strkorr ]-as4user.
  ENDLOOP.

ENDFORM.
