CLASS tr_helper IMPLEMENTATION.
  METHOD tr_set_status_to_changeable.
*   !!! COPY OF TRINT_SET_TO_STATUS_CHANGEABLE with modifications !!!
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(IV_TRKORR) TYPE  TRKORR
*"  EXPORTING
*"     REFERENCE(ES_REQUEST_HEADER) TYPE  TRWBO_REQUEST_HEADER
*"  EXCEPTIONS
*"      WRONG_REQUEST
*"      WRONG_STATUS
*"      NO_AUTHORIZATION
*"      UPDATE_ERROR
*"----------------------------------------------------------------------

    CONSTANTS: lc_waiting_period  TYPE i   VALUE 36. "hours

    DATA: lv_difference     TYPE i,
          lv_textline(100)  TYPE c,
          lv_textline2(100) TYPE c,
          lv_reset_status   TYPE trboolean,
          ls_e070           TYPE e070,
          lv_msgv2          LIKE sy-msgv2,
          lv_msgv3          LIKE sy-msgv3,
          lv_trkorr         TYPE trkorr,
          ls_commit_task    TYPE e070.

*-read request---------------------------------------------------------*
    es_request_header-trkorr = iv_trkorr.
    CALL FUNCTION 'TRINT_READ_REQUEST_HEADER'
      EXPORTING
        iv_read_e070  = 'X'
        iv_read_e070c = 'X'
      CHANGING
        cs_request    = es_request_header
      EXCEPTIONS
        OTHERS        = 1.
    IF sy-subrc <> 0.
*      current_message_raising wrong_request.
    ENDIF.

**-check request changeable---------------------------------------------*
*  CALL FUNCTION 'TRINT_CHECK_REQUEST_CHANGEABLE'
*       EXPORTING
*            is_request_header         = es_request_header
*            iv_allow_status_open      = 'X'
*       EXCEPTIONS
*            request_already_released  = 1
*            user_has_no_authority     = 2
*            USER_IS_NOT_OWNER         = 2
*            OTHERS                    = 3.
*
*  CASE sy-subrc.
*    WHEN 0.
*    WHEN 1. current_message_raising wrong_status.
*    WHEN 2. current_message_raising no_authorization.
*    WHEN 3. current_message_raising wrong_request.
*  ENDCASE.
*
*  CLEAR lv_trkorr.

    IF es_request_header-trstatus EQ sctsc_state_export_started.

*   Check for an open commit task
      SELECT SINGLE * FROM e070 INTO ls_commit_task
              WHERE strkorr EQ iv_trkorr AND
                    trfunction EQ sctsc_type_commit AND
                    trstatus EQ sctsc_state_export_started.

      IF sy-subrc NE 0 OR ls_commit_task IS INITIAL.
*     No open commit task, check the export status of the request
        lv_trkorr = iv_trkorr.
      ENDIF.

      IF ls_commit_task IS NOT INITIAL.
*     Check status of the commit task
        TRY.
            NEW cl_cts_gto_worklist( )->if_cts_gto_worklist~get_worklist( IMPORTING worklist = DATA(lt_worklist) ).
          CATCH cx_cts_gto_exception INTO DATA(exc).
*         No worklist item, check export status of the commit task
            lv_trkorr = ls_commit_task-trkorr.
        ENDTRY.

        READ TABLE lt_worklist INTO DATA(ls_worklist) WITH KEY trkorr = ls_commit_task-trkorr.
        IF ls_worklist-stepstatus EQ if_cts_gto_worklist=>co_step_status_failed OR
           ls_worklist-stepstatus EQ if_cts_gto_worklist=>co_step_status_invalid.
*       The commit or export failed => reset is allowed
          lv_reset_status = 'X'.
        ELSEIF ls_worklist-step EQ if_cts_gto_worklist=>co_step_export AND
               ls_worklist-stepstatus EQ if_cts_gto_worklist=>co_step_status_started.
*       Export was started, check export status of the commit task
          lv_trkorr = ls_commit_task-trkorr.
        ENDIF.
      ENDIF.

      IF lv_trkorr IS NOT INITIAL.
* check if export is still running
* change status of request if
* 1) export is aborted according to tpstat
* 2) tpstat doesn't find an export
*    and the request is longer than 36 hours in status O
* 3) tpstat says that the export is running
*    and the request is longer than 36 hours in status O
*    (that typically means: tp is aborted)
* 4) tpstat says that the export is finished
*    and the request is longer than 1 hour in status O
*    (that typically means: R3trans is aborted, tp continued)
        CALL FUNCTION 'TR_CHECK_EXPORT_STATUS_TPSTAT'
          EXPORTING
            iv_trkorr          = lv_trkorr
          EXCEPTIONS
            export_is_running  = 1
            export_is_finished = 2
            export_is_aborted  = 3
            no_export_found    = 4.
        CASE sy-subrc.
          WHEN 1 OR 4.
            lv_difference = ( sy-datum - es_request_header-as4date ) * 24
                          + ( sy-uzeit - es_request_header-as4time ) DIV 3600.
            IF lv_difference > lc_waiting_period.
              lv_reset_status = 'X'.
            ENDIF.
          WHEN 3.
            lv_reset_status = 'X'.
          WHEN 2.
            lv_difference = ( sy-datum - es_request_header-as4date ) * 24
                          + ( sy-uzeit - es_request_header-as4time ) DIV 3600.
            IF lv_difference > 1.
              lv_reset_status = 'X'.
            ENDIF.
        ENDCASE.
      ENDIF.
    ELSEIF es_request_header-trstatus EQ sctsc_state_preparation
        OR es_request_header-trstatus EQ sctsc_state_released.  "necessarily added
*   Request is in preparation.
*   In this case it is allowed to switch to modifiable.
      lv_reset_status = 'X'.
    ELSE.
      MESSAGE e129(tw) WITH iv_trkorr es_request_header-trstatus. "RAISING wrong_status.
    ENDIF.

*   update status and timestamp of request
    IF lv_reset_status = 'X'.

*---write action log--------------------------------------------------*
      lv_msgv2 = sy-uname.
      lv_msgv3 = iv_trkorr.
      CALL FUNCTION 'TRINT_APPEND_COMM_SYSLOG_ENTRY'
        EXPORTING
          wi_msgid      = 'TK'
          wi_msgno      = '466'
          wi_msgv2      = lv_msgv2
          wi_msgv3      = lv_msgv3
          wi_trfunction = es_request_header-trfunction
          wi_trkorr     = iv_trkorr.

*---update request header----------------------------------------------*
      es_request_header-trstatus = sctsc_state_changeable.
      MOVE-CORRESPONDING es_request_header TO ls_e070.

      CALL FUNCTION 'TRINT_UPDATE_COMM_HEADER'
        EXPORTING
          wi_e070     = ls_e070
          wi_sel_e070 = 'X'
        EXCEPTIONS
          OTHERS      = 1.
      IF   sy-subrc = 1.
*        current_message_raising update_error.
      ENDIF.

      IF ls_commit_task IS NOT INITIAL.
*     Set the status of the commit task to released
        ls_commit_task-trstatus = sctsc_state_released.
        CALL FUNCTION 'TRINT_UPDATE_COMM_HEADER'
          EXPORTING
            wi_e070     = ls_commit_task
            wi_sel_e070 = 'X'
          EXCEPTIONS
            OTHERS      = 1.
        IF   sy-subrc = 1.
*          current_message_raising update_error.
        ENDIF.

*     Clear the table SCTS_GTO_WORKLST and E070_GTO_TASK
*     Direct SQL commands, because currently there is no API for delete
        DELETE FROM scts_gto_worklst WHERE trkorr = ls_commit_task-trkorr.
        DELETE FROM e070_gto_task WHERE task = ls_commit_task-trkorr.
      ENDIF.

    ELSE.
      MESSAGE e568(tk) WITH iv_trkorr. "RAISING wrong_status.
    ENDIF.

  ENDMETHOD.
  METHOD tr_set_status_to_released.

    CALL FUNCTION 'TR_RELEASE_REQUEST'
      EXPORTING
        iv_trkorr                  = iv_trkorr
*       iv_dialog                  = 'X'
*       iv_as_background_job       = ' '
*       iv_success_message         = 'X'
*       iv_display_export_log      = 'X'
*       iv_simulation              = ' '
        iv_without_locking         = abap_false
*       iv_no_release_on_atc_error = ' '
*       iv_atc_options             =
      IMPORTING
        es_request                 = es_request
*       et_deleted_tasks           =
      EXCEPTIONS
        cts_initialization_failure = 1
        enqueue_failed             = 2
        no_authorization           = 3
        invalid_request            = 4
        request_already_released   = 5
        repeat_too_early           = 6
        error_in_export_methods    = 7
        object_check_error         = 8
        docu_missing               = 9
        db_access_error            = 10
        action_aborted_by_user     = 11
        export_failed              = 12
        OTHERS                     = 13.

  ENDMETHOD.
ENDCLASS.

SELECTION-SCREEN BEGIN OF BLOCK b01 WITH FRAME TITLE TEXT-b01.
  PARAMETERS: p_user TYPE xubname OBLIGATORY MATCHCODE OBJECT user_comp,
              p_datu TYPE dats OBLIGATORY VALUE CHECK,
              p_unas TYPE xfeld AS CHECKBOX,
              p_scc1 TYPE xfeld AS CHECKBOX.
SELECTION-SCREEN END OF BLOCK b01.

INITIALIZATION.

  IF sy-sysid(1) <> |E| OR sy-mandt <> |010|.
    MESSAGE ID 'TK' TYPE 'E' NUMBER 294 WITH sy-mandt.
  ENDIF.

* Set Defaults
  p_user = sy-uname.
  p_datu = sy-datum - 90.
  p_unas = abap_true.

  GET PARAMETER ID 'YX_TEC_RESET_TR_TASK' FIELD FINAL(p_mode).

* Get fixed values for TRFUNCTION domain
  CAST cl_abap_elemdescr( cl_abap_typedescr=>describe_by_name( 'TRFUNCTION' ) )->get_ddic_fixed_values(
    EXPORTING
      p_langu        = sy-langu
    RECEIVING
      p_fixed_values = DATA(lt_trfunc_fixvals)
    EXCEPTIONS
      not_found      = 1
      no_ddic_type   = 2
      OTHERS         = 3 )
      .

AT SELECTION-SCREEN OUTPUT.
* Disable User when not in EXPERT mode
  IF p_mode <> 'EXPERT'.
    LOOP AT SCREEN.
      IF screen-name = 'P_USER'.
        screen-input = '0'.
        MODIFY SCREEN.
      ENDIF.
    ENDLOOP.
  ENDIF.

START-OF-SELECTION.

  lcl_event_receiver=>gv_user = p_user.
  lcl_event_receiver=>gv_datu = p_datu.
  lcl_event_receiver=>gv_mode = p_mode.
  lcl_event_receiver=>gv_unas = p_unas.
  lcl_event_receiver=>gv_scc1 = p_scc1.

* Perform selection
  PERFORM select_data USING p_user
                            p_datu
                            p_mode
                            p_unas
                   CHANGING lt_selection[].

  lo_alv = NEW cl_gui_alv_grid( i_parent      = cl_gui_container=>default_screen " in default container einbetten
                                i_appl_events = abap_true ).                     " Ereignisse als Applikationsevents registrieren

* Feldkatalog automatisch durch SALV-Objekte erstellen lassen
  DATA: o_salv TYPE REF TO cl_salv_table.

  TRY.
      cl_salv_table=>factory( IMPORTING
                                r_salv_table = o_salv
                              CHANGING
                                t_table      = lt_selection ).
    CATCH cx_salv_msg.
      WRITE: |Error in ALV.|.
  ENDTRY.
  DATA(it_fcat) = cl_salv_controller_metadata=>get_lvc_fieldcatalog( r_columns      = o_salv->get_columns( )
                                                                     r_aggregations = o_salv->get_aggregations( ) ).

  LOOP AT it_fcat REFERENCE INTO DATA(lr_fieldcat) WHERE fieldname = |LINE_COLOR|.
    lr_fieldcat->no_out = abap_true. "hide color column
  ENDLOOP.

* Layout des ALV setzen
  DATA(lv_layout) = VALUE lvc_s_layo( zebra      = abap_true             " ALV-Control: Alternierende Zeilenfarbe (Zebramuster)
                                      cwidth_opt = 'A'                   " ALV-Control: Spaltenbreite optimieren
                                      grid_title = 'Transport Tasks'     " ALV-Control: Text der Titelzeile
                                      info_fname = 'line_color'          " ALV-Control: Farbe der änderbaren Zeilen
                                      ).

* ALV anzeigen
  lo_alv->set_table_for_first_display( EXPORTING
                                        i_bypassing_buffer = abap_false  " Puffer ausschalten
                                        i_save             = 'A'         " Anzeigevariante sichern
                                        is_layout          = lv_layout   " Layout
                                      CHANGING
                                        it_fieldcatalog    = it_fcat         " Feldkatalog
                                        it_outtab          = lt_selection ). " Ausgabetabelle
*                                        IT_SORT            = GT_SORT ).

* Focus auf ALV setzen
  cl_gui_alv_grid=>set_focus( control = lo_alv ).

* leere SAP-Toolbar ausblenden
  cl_abap_list_layout=>suppress_toolbar( ).

* erzwingen von cl_gui_container=>default_screen
  WRITE: space.

