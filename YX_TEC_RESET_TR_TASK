  METHOD handle_toolbar.
* § 2.In event handler method for event TOOLBAR: Append own functions
*   by using event parameter E_OBJECT.
    DATA: ls_toolbar  TYPE stb_button.
*....................................................................
* E_OBJECT of event TOOLBAR is of type REF TO CL_ALV_EVENT_TOOLBAR_SET.
* This class has got one attribute, namly MT_TOOLBAR, which
* is a table of type TTB_BUTTON. One line of this table is
* defined by the Structure STB_BUTTON (see data deklaration above).
*

* A remark to the flag E_INTERACTIVE:
* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*         'e_interactive' is set, if this event is raised due to
*         the call of 'set_toolbar_interactive' by the user.
*         You can distinguish this way if the event was raised
*         by yourself or by ALV
*         (e.g. in method 'refresh_table_display').
*         An application of this feature is still unknown... :-)

* append a separator to normal toolbar
    CLEAR ls_toolbar.
    MOVE 3 TO ls_toolbar-butn_type.
    APPEND ls_toolbar TO e_object->mt_toolbar.
* append an icon to show booking table
    CLEAR ls_toolbar.
    MOVE 'REFRESH' TO ls_toolbar-function.                      "Refresh
    MOVE icon_refresh TO ls_toolbar-icon.
    MOVE 'Refresh List'(111) TO ls_toolbar-quickinfo.
    MOVE 'Refresh'(112) TO ls_toolbar-text.
    MOVE abap_true TO ls_toolbar-disabled.
    APPEND ls_toolbar TO e_object->mt_toolbar.
    CLEAR ls_toolbar.
    MOVE 'SETR' TO ls_toolbar-function.                        "Reset
    MOVE icon_system_undo TO ls_toolbar-icon.
    MOVE 'Reset Task'(111) TO ls_toolbar-quickinfo.
    MOVE 'Reset'(112) TO ls_toolbar-text.
    MOVE abap_false TO ls_toolbar-disabled.
    APPEND ls_toolbar TO e_object->mt_toolbar.
    CLEAR ls_toolbar.
    MOVE 'RELE' TO ls_toolbar-function.                         "Release
    MOVE icon_transport TO ls_toolbar-icon.
    MOVE 'Release Task'(111) TO ls_toolbar-quickinfo.
    MOVE 'Release'(112) TO ls_toolbar-text.
    MOVE abap_false TO ls_toolbar-disabled.
    APPEND ls_toolbar TO e_object->mt_toolbar.
    CLEAR ls_toolbar.
    MOVE 'TAST' TO ls_toolbar-function.                        "Trasnport Log
    MOVE icon_display_text TO ls_toolbar-icon.
    MOVE 'Show Latest ToC Log'(111) TO ls_toolbar-quickinfo.
    MOVE 'ToC Log'(112) TO ls_toolbar-text.
    MOVE abap_false TO ls_toolbar-disabled.
    APPEND ls_toolbar TO e_object->mt_toolbar.
    CLEAR ls_toolbar.
    MOVE 'SORT' TO ls_toolbar-function.                        "Sort & Compress
    MOVE icon_test TO ls_toolbar-icon.
    MOVE 'Sort and Compress'(111) TO ls_toolbar-quickinfo.
    MOVE 'Sort Task and Compress'(112) TO ls_toolbar-text.
    MOVE abap_false TO ls_toolbar-disabled.
    APPEND ls_toolbar TO e_object->mt_toolbar.
    CLEAR ls_toolbar.
    MOVE 'SCC1N' TO ls_toolbar-function.                        "SCC1N
    MOVE icon_copy_object TO ls_toolbar-icon.
    MOVE 'Copy with SCC1N'(111) TO ls_toolbar-quickinfo.
    MOVE 'SCC1N'(112) TO ls_toolbar-text.
    MOVE abap_false TO ls_toolbar-disabled.
    APPEND ls_toolbar TO e_object->mt_toolbar.

  ENDMETHOD.
