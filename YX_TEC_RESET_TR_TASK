  METHOD handle_user_command.
* § 3.In event handler method for event USER_COMMAND: Query your
*   function codes defined in step 2 and react accordingly.

    DATA: lt_rows        TYPE lvc_t_row,
          lr_trkorr      TYPE RANGE OF trkorr,
          lr_trfunction  TYPE RANGE OF trfunction,
          lr_target_clnt TYPE RANGE OF cccflowv2-client,
          lt_batchdata   TYPE STANDARD TABLE OF bdcdata,
          lt_msg         TYPE STANDARD TABLE OF bdcmsgcoll,
          ls_request     TYPE trwbo_request,
          lv_exit        TYPE c VALUE IS INITIAL,
          lv_where       TYPE string,
          lv_trkorr_toc  TYPE trkorr.

    CALL METHOD lo_alv->get_selected_rows
      IMPORTING
        et_index_rows = lt_rows.

    LOOP AT lt_rows REFERENCE INTO DATA(lr_row).
      ASSIGN lt_selection[ lr_row->index ] TO FIELD-SYMBOL(<lf_task>).
    ENDLOOP.

    CALL METHOD cl_gui_cfw=>flush.
    IF sy-subrc NE 0.
*         add your handling, for example
      CALL FUNCTION 'POPUP_TO_INFORM'
        EXPORTING
          titel = sy-repid
          txt2  = sy-subrc
          txt1  = 'Error in Flush'(500).
    ELSE.
      CASE e_ucomm.
        WHEN 'REFRESH'.
          PERFORM select_data USING lcl_event_receiver=>gv_user
                                    lcl_event_receiver=>gv_datu
                                    lcl_event_receiver=>gv_mode
                                    lcl_event_receiver=>gv_unas
                              CHANGING lt_selection[].
          CALL METHOD cl_gui_cfw=>flush.
          IF sy-subrc NE 0.
            lo_alv->check_changed_data( ).
            lo_alv->refresh_table_display( ).
          ENDIF.

        WHEN 'SETR'.
          CHECK <lf_task>-trstatus <> lc_trstatus_d.
          tr_helper=>tr_set_status_to_changeable( EXPORTING iv_trkorr = <lf_task>-trkorr
                                                  IMPORTING es_request_header = ls_request-h ).
*          ls_e070 = CORRESPONDING #( BASE ( ls_e070 ) <lf_task> ).
*          ls_e070-trstatus = lc_trstatus_d.
*          MODIFY e070 FROM ls_e070.
          IF sy-subrc IS INITIAL.
            MESSAGE s018(tr) WITH ls_request-h-strkorr ls_request-h-trkorr sy-uname. "& request/task & was changed by user &
            CLEAR <lf_task>-line_color.         "Reset line color
            <lf_task>-trstatus = lc_trstatus_d. "Reset ALV status
          ENDIF.

        WHEN 'RELE'.
          CHECK <lf_task>-trstatus <> lc_trstatus_r.
          tr_helper=>tr_set_status_to_released( EXPORTING iv_trkorr  = <lf_task>-trkorr
                                                IMPORTING es_request = ls_request ).
          IF sy-subrc <> 0.
            MESSAGE e492(tr) WITH <lf_task>-trkorr.  "Request &1 has not been released
          ELSE.
            MESSAGE s781(tr) WITH ls_request-h-trkorr ls_request-h-strkorr. "Task &1 has been released to request &2
            <lf_task>-line_color = lc_linecolor_green. "Reset line color
            <lf_task>-trstatus = lc_trstatus_r.        "Reset ALV status
          ENDIF.
*          CALL FUNCTION 'TRINT_TDR_USER_COMMAND'
*            EXPORTING
*              iv_object  = <lf_task>-trkorr
*              iv_type    = space
*              iv_command = e_ucomm
*            IMPORTING
*              ev_exit    = lv_exit.

        WHEN 'SORT'.
          CHECK <lf_task>-trstatus <> lc_trstatus_r.
          CALL FUNCTION 'TRINT_TDR_USER_COMMAND'
            EXPORTING
              iv_object  = <lf_task>-trkorr
              iv_type    = space
              iv_command = e_ucomm
            IMPORTING
              ev_exit    = lv_exit.
          IF sy-subrc <> 0.
            MESSAGE e041(tk). "Error saving objects for request/task &1
          ELSE.
            MESSAGE s148(tk). "Object and key entries were sorted and compressed
          ENDIF.

        WHEN 'SCC1N'.
          DATA(lv_target) = |100|.
          TRY.

*           Build ranges
              lr_trkorr[] = VALUE #( ( sign   = 'I'
                                       option = 'EQ'
                                       low    = <lf_task>-trkorr
                                       high   = '' ) ).

              lr_trfunction[] = VALUE #( ( sign   = 'I'
                                           option = 'EQ'
                                           low    = <lf_task>-trfunction
                                           high   = '' ) ).

              lr_target_clnt[] = VALUE #( ( sign   = 'I'
                                            option = 'EQ'
                                            low    = lv_target
                                            high   = '' ) ).

*           Call SCC1N
              IF gv_scc1 = abap_false.
                SUBMIT rs_scc1_trkorr_batch_copy VIA SELECTION-SCREEN
                                                 WITH trkorr   IN lr_trkorr
                                                 WITH trfunct  IN lr_trfunction
                                                 WITH src_clnt = sy-mandt
                                                 WITH trg_clnt IN lr_target_clnt
*                                                 WITH test_run = abap_true
                                                 AND RETURN
                                                 .
              ELSE.
                SUBMIT rs_scc1_trkorr_batch_copy WITH trkorr   IN lr_trkorr
                                                 WITH trfunct  IN lr_trfunction
                                                 WITH src_clnt = sy-mandt
                                                 WITH trg_clnt IN lr_target_clnt
*                                                 WITH test_run = abap_true
                                                 AND RETURN
                                                 .
              ENDIF.

            CATCH cx_root INTO DATA(lx_root).

          ENDTRY.
          IF lx_root IS NOT INITIAL.
            MESSAGE 'Error while calling SCC1N' TYPE 'S' DISPLAY LIKE 'E'.
          ELSE.
            MESSAGE s723(tr) WITH |{ sy-sysid } { sy-mandt }| <lf_task>-trkorr |{ sy-sysid } { lv_target }|. "Objects passed from &1 (&2) to &3
          ENDIF.

        WHEN 'TAST'.                    "Transport Log
          lv_where = |{ <lf_task>-strkorr }%|.
          SELECT SINGLE
            FROM  e071 AS o
            INNER JOIN e070 AS e
            ON o~trkorr = e~trkorr
          FIELDS MAX( o~trkorr )
           WHERE o~obj_name LIKE @lv_where
             AND o~pgmid  = 'CORR'
             AND o~object = 'MERG'
             AND e~trfunction = @lc_trfunction_t
             INTO @lv_trkorr_toc.

          DATA(ls_popup) = VALUE strhi_popup( start_column = 1
                                              start_row    = 1
                                              end_column   = 250
                                              end_row      = 250
                                               ) .
          IF lv_trkorr_toc IS NOT INITIAL.
            CALL FUNCTION 'TRINT_TDR_USER_COMMAND'
              EXPORTING
                iv_object  = lv_trkorr_toc
                iv_type    = space
                iv_command = e_ucomm
              IMPORTING
                ev_exit    = lv_exit.
            IF sy-subrc <> 0.
              CALL FUNCTION 'POPUP_TO_INFORM'
                EXPORTING
                  titel = sy-repid
                  txt1  = |Error while producing ToC Log for { lv_trkorr_toc }.|
                  txt2  = space.
            ENDIF.
          ELSE.
*             add your handling, for example
            CALL FUNCTION 'POPUP_TO_INFORM'
              EXPORTING
                titel = sy-repid
                txt1  = |No ToCs released so far for { <lf_task>-strkorr }.|
                txt2  = space.
          ENDIF.

      ENDCASE.

      COMMIT WORK.
      lo_alv->refresh_table_display( ).
      CLEAR: ls_request.

    ENDIF.
  ENDMETHOD.                           "handle_user_command
